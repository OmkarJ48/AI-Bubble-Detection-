# Ignore Python cache
__pycache__/
*.pyc
*.pyo
*.pyd

# Ignore virtual environments
venv/
env/
.venv/
.env/

# VS Code settings (if you don’t want them in git)
.vscode/

# Byte-compiled / temporary files
*.log
*.tmp

# Common Python tooling dirs
.mypy_cache/
.pytest_cache/
.python-version
coverage.xml
htmlcov/

# Build and distribution
build/
dist/
*.egg-info/
node_modules/

# static files
*.json
!tools/tailwind/package.json
!tools/tailwind/package-lock.json
!profiles/*.json
*.csv
*.pdf
*.mp4
!Bubbles*.mp4
!Prototype Dataset 1/*.mp4
*.mov
*.MOV
bubble_log*.jsonl
